NODE_ENV=development
HOST=0.0.0.0
PORT=3000
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# Scryfall (defaults: https://api.scryfall.com, 10 req/s)
SCRYFALL_API_BASE=https://api.scryfall.com
SCRYFALL_RATE_LIMIT=10

# Rate limiting (defaults: 100 requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
